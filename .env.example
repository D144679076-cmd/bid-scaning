# Copy to .env and fill in. NEVER commit .env.
TG_TOKEN=123456:ABC-your-telegram-bot-token
TG_CHAT_ID=123456789
# M2: Ollama CLOUD profile key (only used when config llm.active: cloud;
# local Ollama works without it). Get at ollama.com → Settings → API keys.
LLM_API_KEY=


# Telegram commands owner (allowlist for /scan /pause etc.)
TG_OWNER_ID=
